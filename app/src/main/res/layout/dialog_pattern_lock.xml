<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tvPatternDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔐 KUNCI MENU PENGATURAN"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPatternDialogPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gambar pola untuk membuka menu pengaturan"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:gravity="center" />

    <!-- 3x3 Pattern Lock View -->
    <com.gt06.gpscontroller.PatternLockView
        android:id="@+id/patternLockView"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/tvPatternDialogStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hubungkan minimal 4 titik pola"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnPatternDialogBiometric"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/btn_location_bg"
            android:text="👆 Sidik Jari"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnPatternDialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/tab_inactive_bg"
            android:text="Batal"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>

</LinearLayout>
