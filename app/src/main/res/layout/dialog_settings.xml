<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/card_background">

    <!-- Header Dialog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙️ Pengaturan GPS Control"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atur nomor SIM tracker tujuan SMS dan preferensi pengiriman perintah."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <!-- Field Nomor SIM Card Tracker (Editable) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nomor Kartu SIM GPS Tracker"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_editable_bg"
            android:text="✏️ DAPAT DIEDIT"
            android:textColor="#0284C7"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etSettingsGpsNumber"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_editable_bg"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:cursorVisible="true"
        android:inputType="phone"
        android:hint="Contoh: 085117007880"
        android:textColor="@color/text_primary"
        android:textColorHint="#94A3B8"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingStart="14dp"
        android:paddingEnd="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ketik nomor kartu SIM yang terpasang pada modul GPS tracker Anda."
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <!-- Opsi Kirim SMS Langsung -->
    <CheckBox
        android:id="@+id/cbSettingsDirectSms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Kirim SMS langsung (Direct Background)"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jika dimatikan, aplikasi akan membuka aplikasi SMS bawaan Android saat mengirim perintah."
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="20dp" />

    <!-- Tombol Aksi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnSettingsCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/input_bg"
            android:text="Tutup"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <Button
            android:id="@+id/btnSettingsSave"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_location_bg"
            android:text="Simpan Preferensi"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

</LinearLayout>
